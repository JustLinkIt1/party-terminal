# Required. The auth token sent as `x-api-key` to Anthropic (or to your proxy).
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Set to route requests through a proxy (e.g. a Claude Max relay)
# instead of api.anthropic.com. The proxy must accept the Anthropic Messages
# API shape and the `x-api-key` header.
# ANTHROPIC_BASE_URL=https://your-proxy.example.com

# Optional. Override the model id. Defaults to claude-sonnet-4-6.
# If your proxy maps to a different upstream model, set this accordingly.
# CLAUDE_MODEL=claude-sonnet-4-6
